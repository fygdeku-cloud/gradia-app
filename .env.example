# Copy this file to .env locally and replace every placeholder before use.
# Keep .env out of version control.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_READ_DOT_ENV_FILE=false
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret

# Existing PostgreSQL database; confirm the database and role before connecting.
POSTGRES_DB=gradia_bd
POSTGRES_USER=replace-with-existing-postgres-role
POSTGRES_PASSWORD=replace-with-the-role-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

SITE_URL=http://127.0.0.1:8000
USE_DOCKER=false
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Optional integrations; leave empty until configured with sandbox credentials.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
USE_S3_STORAGE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
